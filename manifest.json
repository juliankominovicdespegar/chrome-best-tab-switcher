{
  "manifest_version": 3,
  "name": "Best Tab Switcher",
  "description": "Fast tab switcher with search, thumbnails, and recently closed tabs",
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "tabs",
    "favicon",
    "history",
    "sessions",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "open-switcher": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open tab switcher"
    }
  }
}
